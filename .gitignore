# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / frontend build inputs (dist IS committed — it is the served SPA)
node_modules/
frontend/tsconfig.tsbuildinfo

# Databricks bundle state
.databricks/

# Generated code-graph output (graphify) + Isaac config — local analysis artifacts,
# not template content.
graphify-out/
.isaac/

# Generated build/verify reports written by the deploy + test scripts at runtime.
# These carry workspace-specific coordinates (catalog/schema/endpoint ids), so they
# are validation artifacts, not template content.
.planning/
src/.planning/

# Session working notes — the end-to-end validation record. Explicitly NOT part of
# the template; kept locally for reference, never shipped.
REBUILD-PROGRESS.md
VALIDATION-HANDOFF.md

# Rendered Genie space payload — build artifact from genie/genie_space.template.json
# (produced by src/deploy/render_genie.py; the template is the tracked source of truth).
genie/genie_space.json

# OS / IDE
.DS_Store
*.swp
.idea/
.vscode/

# Private eval answer key — must never be committed (see eval/prompts_loader.py)
data/servicenow/Prompts.md

# Additional ignores (from the industry-solutions scaffold; dist/ intentionally NOT
# ignored — frontdoor/frontend/dist is the committed served SPA)
*.swo
*$py.class
*.egg-info/
build/
.ipynb_checkpoints/
Thumbs.db
.env
.env.local
